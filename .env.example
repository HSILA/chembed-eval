# Copy to .env.local and fill values. Never commit real keys.

# Supabase (project chembed-rag)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only service key (secret key). Never expose to the browser.
SUPABASE_SECRET_KEY=
# The existing Python passage importer uses this separate setting.
SUPABASE_SERVICE_ROLE_KEY=

# Pinecone (indexes: chembed-eval-base, chembed-eval-progressive; fine to use
# the same key for both)
PINECONE_API_KEY=
PINECONE_INDEX_BASE=chembed-eval-base
PINECONE_INDEX_PROGRESSIVE=chembed-eval-progressive

# Modal (private token; generate with `modal token new` and copy the id/secret)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_APP_NAME=chembed-eval-models
MODAL_CLASS_BASE=ModelServerBase
MODAL_CLASS_PROGRESSIVE=ModelServerProg
